From 5189bc8247706af0a3f6ade576f3f5c14dd6d9d0 Mon Sep 17 00:00:00 2001
From: guacamoleg <guacamoleg@localhost>
Date: Sat, 14 Nov 2026 12:12:52 +0000
Subject: [PATCH] arm64: configs: guacamoleg: turn on esoc for the SDX50M

Change-Id: I653faa78571a8edaaf570e55e5cc9d01e3951137
---
 arch/arm64/configs/vendor/guacamoleg.config | 8 ++++++++
 1 file changed, 8 insertions(+)
 create mode 100644 arch/arm64/configs/vendor/guacamoleg.config

diff --git a/arch/arm64/configs/vendor/guacamoleg.config b/arch/arm64/configs/vendor/guacamoleg.config
new file mode 100644
index 000000000000..e7fffb4dcfc4
--- /dev/null
+++ b/arch/arm64/configs/vendor/guacamoleg.config
@@ -0,0 +1,8 @@
+# OnePlus 7 Pro 5G (18827): the SDX50M 5G modem, an external modem on PCIe driven by esoc.
+# oplus.config turns esoc off (the OnePlus 7 Pro has no external modem); these are OxygenOS 10's own settings.
+CONFIG_ESOC=y
+CONFIG_ESOC_DEV=y
+CONFIG_ESOC_CLIENT=y
+CONFIG_ESOC_MDM_4x=y
+CONFIG_ESOC_MDM_DRV=y
+CONFIG_ESOC_MDM_DBG_ENG=y
-- 
2.53.0

