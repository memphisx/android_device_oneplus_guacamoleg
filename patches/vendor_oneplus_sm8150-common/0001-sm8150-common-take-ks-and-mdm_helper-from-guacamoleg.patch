Subject: [PATCH] sm8150-common: take ks and mdm_helper from guacamoleg, which
 has its own

---
 Android.bp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Android.bp b/Android.bp
index 87bfc53..bb867bb 100644
--- a/Android.bp
+++ b/Android.bp
@@ -18236,7 +18236,7 @@ cc_prebuilt_binary {
     target: {
         android_arm64: {
             srcs: [
-                "proprietary/vendor/bin/ks",
+                ":guacamoleg_ks",
             ],
             shared_libs: [
                 "libc",
@@ -18324,7 +18324,7 @@ cc_prebuilt_binary {
     target: {
         android_arm64: {
             srcs: [
-                "proprietary/vendor/bin/mdm_helper",
+                ":guacamoleg_mdm_helper",
             ],
             shared_libs: [
                 "libcutils",
